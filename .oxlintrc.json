{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "options": {
    "typeAware": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "off",
    "style": "off",
    "restriction": "off",
    "pedantic": "off",
    "nursery": "off"
  },
  "plugins": ["typescript", "unicorn", "import", "promise", "oxc"],
  "rules": {
    "import/no-cycle": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "unicorn/prefer-node-protocol": "error"
  },
  "overrides": [
    {
      "files": ["packages/**/*.test.ts"],
      "rules": {
        "typescript/await-thenable": "off",
        "typescript/no-floating-promises": "off",
        "typescript/no-non-null-assertion": "off",
        "typescript/no-unnecessary-type-assertion": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-type-assertion": "off"
      }
    },
    {
      "files": ["packages/session-daemon/src/serve.ts"],
      "rules": {
        "promise/always-return": "off",
        "typescript/no-floating-promises": "off",
        "typescript/no-unnecessary-type-assertion": "off"
      }
    },
    {
      "files": ["packages/session-daemon/src/connection.ts"],
      "rules": {
        "typescript/no-unsafe-type-assertion": "off",
        "unicorn/prefer-add-event-listener": "off"
      }
    },
    {
      "files": [
        "packages/session-core/src/brokerState.ts",
        "packages/session-core/src/brokerWire.ts",
        "packages/session-daemon/src/daemon.ts"
      ],
      "rules": {
        "typescript/no-unnecessary-type-assertion": "off",
        "typescript/no-unsafe-type-assertion": "off"
      }
    },
    {
      "files": ["packages/session-core/src/limits.ts"],
      "rules": {
        "typescript/no-unsafe-assignment": "off"
      }
    },
    {
      "files": ["packages/session-daemon/src/broker.ts"],
      "rules": {
        "typescript/no-unnecessary-type-assertion": "off"
      }
    }
  ]
}
