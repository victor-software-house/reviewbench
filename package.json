  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "optionalDependencies": {
    "@turbo/darwin-arm64": "2.10.9",
    "@turbo/linux-64": "2.10.9"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@changesets/cli": "2.31.1",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@types/bun": "1.3.14",
    "lefthook": "2.1.10",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "turbo": "2.10.9",
    "typescript": "7.0.2"
  },
  "devEngines": {
    "packageManager": {
